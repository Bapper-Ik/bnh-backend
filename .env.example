ENVIRONMENT=development
DATABASE_SSL=true
# Use a separate database for each environment, with schema-changing privileges.
# Development example; production must point to its own database.
DATABASE_URL=postgresql://custodian_owner:REPLACE_ME@127.0.0.1:55438/custodian_dev
ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

# Enable only after configuring a verified Resend sender and private secrets.
MAIL_ENABLED=false
# MAIL_FROM=access@example.com
# RESEND_API_KEY=REPLACE_ME
# ACCOUNT_LINK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# FRONTEND_ORIGIN=http://localhost:5173

# Private supporting documents: backend only. Do not configure both forms.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET.
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_COUNT=10
